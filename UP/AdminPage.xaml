<Page x:Class="UP.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Администрирование"
      Background="Transparent">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="225"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--
        /// <summary>
        /// Левое боковое меню администратора
        /// </summary>
        /// <remarks>
        /// Содержит кнопки для доступа к разделам управления:
        /// - Жалобы (ComplaintsBtn) - управление жалобами на книги, отзывы, авторов
        /// - аявки на разморозку (UnfreezeBtn) - обработка заявок на разморозку аккаунтов/книг
        /// - Заявки на роль автора (RoleRequestsBtn) - одобрение/отклонение заявок
        /// - Замороженные пользователи (FrozenUsersBtn) - просмотр и разморозка пользователей
        /// - Замороженные книги (FrozenBooksBtn) - просмотр и разморозка книг
        /// - Замороженные отзывы (FrozenReviewsBtn) - просмотр и разморозка отзывов
        /// - Все пользователи (UsersBtn) - управление пользователями (смена роли, пароля)
        /// 
        /// Фон меню: #4A3424 (тёмно-коричневый) - основной цвет акцентов приложения.
        /// Кнопки: прозрачный фон, белый текст, внутренние отступы 15px по горизонтали, 10px по вертикали.
        /// При наведении фон кнопки меняется на #6F7D54 (более светлый оттенок) - эффект реализован в стилях.
        /// </remarks>
        -->
        <Border Grid.Column="0" Background="#4A3424">
            <StackPanel Margin="0,20">
                <Button x:Name="ComplaintsBtn" Content="Жалобы" 
                        Background="Transparent" Foreground="#C2CDB2" 
                        Padding="15,10" Click="ComplaintsBtn_Click"/>
                <Button x:Name="UnfreezeBtn" Content="Заявки на разморозку" 
                        Background="Transparent" Foreground="#C2CDB2" 
                        Padding="15,10" Click="UnfreezeBtn_Click"/>
                <Button x:Name="RoleRequestsBtn" Content="Заявки на роль автора" 
                        Background="Transparent" Foreground="#C2CDB2" 
                        Padding="15,10" Click="RoleRequestsBtn_Click"/>
                <Button x:Name="FrozenUsersBtn" Content="Замороженные пользователи" 
                        Background="Transparent" Foreground="#C2CDB2" 
                        Padding="15,10" Click="FrozenUsersBtn_Click"/>
                <Button x:Name="FrozenBooksBtn" Content="Замороженные книги" 
                        Background="Transparent" Foreground="#C2CDB2" 
                        Padding="15,10" Click="FrozenBooksBtn_Click"/>
                <Button x:Name="FrozenReviewsBtn" Content="Замороженные отзывы" 
                        Background="Transparent" Foreground="#C2CDB2" 
                        Padding="15,10" Click="FrozenReviewsBtn_Click"/>
                <Button x:Name="UsersBtn" Content="Все пользователи" 
                        Background="Transparent" Foreground="#C2CDB2" 
                        Padding="15,10" Click="UsersBtn_Click"/>
            </StackPanel>
        </Border>

        <!--
        /// <summary>
        /// Правая область отображения контента
        /// </summary>
        /// <remarks>
        /// Содержит динамически загружаемый контент в зависимости от выбранного пункта меню.
        /// Использует ScrollViewer для обеспечения прокрутки при большом объёме данных.
        /// 
        /// Возможные типы контента:
        /// - Список жалоб (с кнопками "Принять"/"Отклонить")
        /// - Список заявок на разморозку (с кнопками "Одобрить"/"Отклонить")
        /// - Список заявок на роль автора (с кнопками "Одобрить"/"Отклонить")
        /// - Список замороженных пользователей (с кнопкой "Разморозить")
        /// - Список замороженных книг (с кнопкой "Разморозить")
        /// - Список замороженных отзывов (с кнопкой "Разморозить")
        /// - Список всех пользователей (с ComboBox для смены роли и полем для смены пароля)
        /// 
        /// Цвет фона: прозрачный, внутренние отступы: 20px.
        /// </remarks>
        -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentPanel" Margin="20"/>
        </ScrollViewer>
    </Grid>
</Page>