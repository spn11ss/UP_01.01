<!--
/// <summary>
/// Главное окно приложения "Читай, Пиши и не спиши"
/// </summary>
/// <remarks>
/// Окно состоит из боковой панели (сайдбар) с кнопками навигации и области для отображения страниц (Frame).
/// Размер окна: 1200x700, открывается по центру экрана.
/// Кнопки AdminBtn и AuthorBtn изначально скрыты, отображаются в зависимости от роли пользователя.
/// Все кнопки используют стиль SidebarButton (описан в App.xaml).
/// </remarks>
-->
<Window x:Class="UP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP"
        mc:Ignorable="d"
        Title="Читай, Пиши и не спиши" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--
        /// <summary>
        /// Боковая панель навигации (зелёная область слева)
        /// </summary>
        /// <remarks>
        /// Содержит 5 кнопок: Каталог, Списки, Администрирование, Страница автора, Профиль.
        /// Кнопки админа и автора скрыты по умолчанию (Visibility="Collapsed").
        /// Каждая кнопка имеет иконку 32x32 и всплывающую подсказку.
        /// </remarks>
        -->
        <Border Grid.Column="0" Background="#8A9A6E">
            <StackPanel VerticalAlignment="Top" Margin="0,20,0,0">
                
                <Button x:Name="CatalogBtn" Click="CatalogBtn_Click" Style="{StaticResource SidebarButton}">
                    <Button.ToolTip>
                        <ToolTip>Каталог книг</ToolTip>
                    </Button.ToolTip>
                    <StackPanel>
                        <Image Source="/Resources/book.png" Width="32" Height="32"/>
                    </StackPanel>
                </Button>
                
                <Button x:Name="ListsBtn" Click="ListsBtn_Click" Style="{StaticResource SidebarButton}">
                    <Button.ToolTip>
                        <ToolTip>Списки книг</ToolTip>
                    </Button.ToolTip>
                    <StackPanel>
                        <Image Source="/Resources/list.png" Width="32" Height="32"/>
                    </StackPanel>
                </Button>

                <Button x:Name="AdminBtn" Click="AdminBtn_Click" Style="{StaticResource SidebarButton}" Visibility="Collapsed">
                    <Button.ToolTip>
                        <ToolTip>Администрирование</ToolTip>
                    </Button.ToolTip>
                    <StackPanel>
                        <Image Source="/Resources/admin.png" Width="32" Height="32"/>
                    </StackPanel>
                </Button>

                <Button x:Name="AuthorBtn" Click="AuthorBtn_Click" Style="{StaticResource SidebarButton}" Visibility="Collapsed">
                    <Button.ToolTip>
                        <ToolTip>Страница автора</ToolTip>
                    </Button.ToolTip>
                    <StackPanel>
                        <Image Source="/Resources/author.png" Width="32" Height="32"/>
                    </StackPanel>
                </Button>

                <Button x:Name="ProfileBtn" Click="ProfileBtn_Click" Style="{StaticResource SidebarButton}">
                    <Button.ToolTip>
                        <ToolTip>Профиль</ToolTip>
                    </Button.ToolTip>
                    <StackPanel>
                        <Image Source="/Resources/user.png" Width="32" Height="32"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!--
        /// <summary>
        /// Область отображения контента
        /// </summary>
        /// <remarks>
        /// Frame с именем MainFrame служит контейнером для страниц (Page).
        /// NavigationUIVisibility="Hidden" скрывает стандартные кнопки навигации браузера.
        /// При нажатии на кнопки сайдбара в этот Frame подгружаются соответствующие страницы.
        /// </remarks>
        -->
        <Border Grid.Column="1" Background="#C2CDB2">
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
        </Border>
    </Grid>
</Window>

