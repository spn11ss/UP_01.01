<Page x:Class="UP.BookWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Книга"
      Background="Transparent">

    <Page.Resources>
        <!--
        /// <summary>
        /// Стиль для кнопок действий на странице книги
        /// </summary>
        /// <remarks>
        /// Применяется к кнопкам:
        /// - "В список" (добавление книги в пользовательский список)
        /// - "Жалоба на книгу" (подача жалобы на книгу)
        /// - "Жалоба на автора" (подача жалобы на автора)
        /// - "Заморозить книгу" (доступно только администратору)
        /// 
        /// Параметры стиля:
        /// - Внутренние отступы: 15px слева/справа, 8px сверху/снизу
        /// - Внешние отступы: 5px со всех сторон
        /// - Курсор меняется на "руку" при наведении
        /// - Без рамки, белый текст, размер шрифта 12
        /// </remarks>
        -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!--
            /// <summary>
            /// Шапка страницы с названием книги и автором
            /// </summary>
            /// <remarks>
            /// Фон: #4A3424 (тёмно-коричневый) - основной цвет акцентов приложения.
            /// Закруглённые углы: CornerRadius="10".
            /// Внутренние отступы: 20px, внешние отступы снизу: 20px.
            /// 
            /// Название книги: размер шрифта 22, жирное, белый цвет.
            /// Имя автора: размер шрифта 14, цвет #C2CDB2 (светло-зелёный).
            /// </remarks>
            -->
            <Border Background="#4A3424" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{Binding BookName}" FontSize="22" FontWeight="Bold" Foreground="#C2CDB2" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding AuthorName}" FontSize="14" Foreground="#C2CDB2" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!--
            /// <summary>
            /// Блок с обложкой и основной информацией о книге
            /// </summary>
            /// <remarks>
            /// Содержит:
            /// - Обложку книги (Image) - привязана к полю Image
            /// - Описание книги (Description)
            /// - Список жанров (Genres)
            /// - Рейтинг (Rating)
            /// - Кнопки действий (в список, жалобы, заморозка)
            /// 
            /// Обложка: ширина 200px, высота 280px, отступы 10px.
            /// Текст описания: цвет #4A3424, перенос по словам.
            /// Жанры и рейтинг: цвет #4A3424.
            /// </remarks>
            -->

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Source="{Binding Image}" Width="200" Height="280" Stretch="UniformToFill" 
                       Margin="0,0,20,0" HorizontalAlignment="Left"/>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="О книге" FontSize="16" FontWeight="Bold" Foreground="#4A3424" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#4A3424" Margin="0,0,0,15"/>

                    <TextBlock Text="Жанры:" FontWeight="Bold" Foreground="#4A3424"/>
                    <TextBlock Text="{Binding Genres}" Foreground="#4A3424" Margin="0,5,0,15"/>

                    <TextBlock Text="⭐ Рейтинг:" FontWeight="Bold" Foreground="#4A3424"/>
                    <TextBlock Text="{Binding Rating}" Foreground="#E74C3C" Margin="0,5,0,15" FontSize="16"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="AddToListBtn" Content="В список" Style="{StaticResource ActionButton}" 
                                Background="#C2CDB2" BorderThickness="1" BorderBrush="#4A3424" Foreground="#4A3424" 
                                Click="AddToListBtn_Click"/>
                        <Button x:Name="ComplainBookBtn" Content="Жалоба на книгу" Style="{StaticResource ActionButton}" 
                                Background="#E74C3C" Click="ComplainBookBtn_Click"/>
                        <Button x:Name="ComplainAuthorBtn" Content="Жалоба на автора" Style="{StaticResource ActionButton}" 
                                Background="#E74C3C" Click="ComplainAuthorBtn_Click"/>
                        <Button x:Name="FreezeBookBtn" Content="Заморозить книгу" Style="{StaticResource ActionButton}" 
                                Background="#F39C12" Click="FreezeBookBtn_Click" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!--
            /// <summary>
            /// Блок чтения текста книги
            /// </summary>
            /// <remarks>
            /// Фон: #8A9A6E (оливковый).
            /// Внутренние отступы: 20px, внешние отступы снизу: 20px.
            /// 
            /// Текст отображается в ScrollViewer с максимальной высотой 300px.
            /// При превышении высоты появляется полоса прокрутки.
            /// Цвет текста: #4A3424, размер шрифта 14, межстрочный интервал 1.5.
            /// </remarks>
            -->
            <Border Background="#8A9A6E" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Чтение" FontSize="16" FontWeight="Bold" Foreground="#4A3424" Margin="0,0,0,10"/>
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#4A3424" FontSize="14" LineHeight="1.5"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!--
            /// <summary>
            /// Блок отзывов на книгу
            /// </summary>
            /// <remarks>
            /// Фон: белый.
            /// Внутренние отступы: 20px.
            /// 
            /// Содержит:
            /// 1. Форму добавления отзыва (ComboBox с рейтингом, TextBox для текста, кнопка отправки)
            /// 2. Список существующих отзывов (ItemsControl)
            /// 3. Сообщение "Нет отзывов" при пустом списке
            /// 
            /// Цвета:
            /// - Заголовок: #4A3424
            /// - Форма добавления: фон #F0F3F4
            /// - Карточка отзыва: фон #F8F9FA
            /// - Рейтинг в отзыве: цвет #E74C3C
            /// </remarks>
            -->
            <Border Background="White" Padding="20">

                <StackPanel>
                    <TextBlock Text="💬 Отзывы" FontSize="16" FontWeight="Bold" Foreground="#4A3424" Margin="0,0,0,15"/>

                    <!-- Форма добавления отзыва -->
                    <Border Background="#F8F9FA" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Оставить отзыв:" FontWeight="Bold" Foreground="#4A3424" Margin="0,0,0,10"/>
                            <ComboBox x:Name="RatingBox" Margin="0,0,0,10" Width="100" HorizontalAlignment="Left"
                                      Background="#C2CDB2" Foreground="#4A3424">
                                <ComboBoxItem Content="⭐ 1"/>
                                <ComboBoxItem Content="⭐ 2"/>
                                <ComboBoxItem Content="⭐ 3"/>
                                <ComboBoxItem Content="⭐ 4"/>
                                <ComboBoxItem Content="⭐ 5"/>
                                <ComboBoxItem Content="⭐ 6"/>
                                <ComboBoxItem Content="⭐ 7"/>
                                <ComboBoxItem Content="⭐ 8" IsSelected="True"/>
                                <ComboBoxItem Content="⭐ 9"/>
                                <ComboBoxItem Content="⭐ 10"/>
                            </ComboBox>
                            <TextBox x:Name="ReviewText" TextWrapping="Wrap" Height="80" 
                                     Padding="10" Margin="0,10,0,10" AcceptsReturn="True"
                                     Background="#C2CDB2" Foreground="#4A3424"/>
                            <Button x:Name="SubmitReviewBtn" Content="Оставить отзыв" 
                                    Background="#4A3424" Foreground="#C2CDB2" FontWeight="Bold"
                                    Cursor="Hand" Width="120" Click="SubmitReviewBtn_Click"/>
                        </StackPanel>
                    </Border>


                    <ItemsControl x:Name="ReviewsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8F9FA" Padding="15" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                <TextBlock Text="{Binding UserName}" FontWeight="Bold" FontSize="13" Foreground="#4A3424"/>
                                                <TextBlock Text=" · " Foreground="#4A3424"/>
                                                <TextBlock Text="{Binding DateReview, StringFormat='dd.MM.yyyy'}" 
                                                           FontSize="11" Foreground="#4A3424"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Text="{Binding Rating, StringFormat='⭐ {0}/10'}" 
                                                           Foreground="#E74C3C" FontSize="12"/>
                                                <Button Content="⚠️" Background="Transparent" BorderThickness="0"
                                                        Foreground="#E74C3C" Cursor="Hand" FontSize="14"
                                                        Margin="10,0,0,0" Click="ComplainReviewBtn_Click"
                                                        Tag="{Binding ID}"/>
                                                <Button x:Name="FreezeReviewBtn" Content="🔒" 
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="#F39C12" Cursor="Hand" FontSize="14"
                                                        Margin="5,0,0,0" Click="FreezeReviewBtn_Click"
                                                        Tag="{Binding ID}" Visibility="Collapsed"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#4A3424"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="NoReviewsText" Text="Пока нет отзывов. Будьте первым!" 
                               Foreground="#4A3424" HorizontalAlignment="Center" Margin="0,20"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>