<Window x:Class="UP.SelectStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP"
        mc:Ignorable="d"
         Title="Добавить в список" Height="300" Width="300"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Grid Margin="20">
        <StackPanel>
            <!--
            /// <summary>
            /// Заголовок окна выбора статуса
            /// </summary>
            /// <remarks>
            /// Отображает текст-подсказку для пользователя.
            /// Цвет текста #4A3424 (тёмно-коричневый), размер шрифта 14.
            /// Отступ снизу 15px для отделения от кнопок.
            /// </remarks>
            -->
            <TextBlock Text="Выберите статус для книги:" Foreground="#4A3424" FontSize="14" Margin="0,0,0,15"/>

            <!--
            /// <summary>
            /// Кнопка выбора статуса "В планах"
            /// </summary>
            /// <remarks>
            /// Параметры:
            /// - Content: "В планах" - текст на кнопке
            /// - Tag: "1" - ID статуса в таблице BookStatuses
            /// - Background: #3498DB (синий)
            /// - Foreground: White - цвет текста
            /// - Height: 40px, отступ снизу: 5px
            /// При нажатии вызывает StatusBtn_Click с передачей Tag
            /// </remarks>
            -->
            <Button x:Name="PlanBtn" Content="В планах" Height="40" Margin="0,5" 
                    Click="StatusBtn_Click" Tag="1" Background="#3498DB" Foreground="White"/>

            <!--
            /// <summary>
            /// Кнопка выбора статуса "Читаю"
            /// </summary>
            /// <remarks>
            /// Параметры:
            /// - Content: "Читаю" - текст на кнопке
            /// - Tag: "2" - ID статуса в таблице BookStatuses
            /// - Background: #F39C12 (оранжевый)
            /// - Foreground: White - цвет текста
            /// - Height: 40px, отступ снизу: 5px
            /// При нажатии вызывает StatusBtn_Click с передачей Tag
            /// </remarks>
            -->
            <Button x:Name="ReadingBtn" Content="Читаю" Height="40" Margin="0,5"
                    Click="StatusBtn_Click" Tag="2" Background="#F39C12" Foreground="White"/>

            <!--
            /// <summary>
            /// Кнопка выбора статуса "Прочитано"
            /// </summary>
            /// <remarks>
            /// Параметры:
            /// - Content: "Прочитано" - текст на кнопке
            /// - Tag: "3" - ID статуса в таблице BookStatuses
            /// - Background: #27AE60 (зелёный) 
            /// - Foreground: White - цвет текста
            /// - Height: 40px, отступ снизу: 5px
            /// При нажатии вызывает StatusBtn_Click с передачей Tag
            /// </remarks>
            -->
            <Button x:Name="ReadBtn" Content="Прочитано" Height="40" Margin="0,5"
                    Click="StatusBtn_Click" Tag="3" Background="#27AE60" Foreground="White"/>

            <!--
            /// <summary>
            /// Кнопка выбора статуса "Заброшено"
            /// </summary>
            /// <remarks>
            /// Параметры:
            /// - Content: "Заброшено" - текст на кнопке
            /// - Tag: "4" - ID статуса в таблице BookStatuses
            /// - Background: #E74C3C (красный)
            /// - Foreground: White - цвет текста
            /// - Height: 40px, отступ снизу: 5px
            /// При нажатии вызывает StatusBtn_Click с передачей Tag
            /// </remarks>
            -->
            <Button x:Name="AbandonedBtn" Content="Заброшено" Height="40" Margin="0,5"
                    Click="StatusBtn_Click" Tag="4" Background="#E74C3C" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
