<Page x:Class="UP.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Профиль"
      Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!--
            /// <summary>
            /// Блок информации о пользователе
            /// </summary>
            /// <remarks>
            /// Отображает основные данные текущего пользователя:
            /// - Имя (UserName)
            /// - Логин
            /// - Email
            /// - Роль (Читатель/Автор/Администратор)
            /// 
            /// Фон: белый, внутренние отступы: 20px, внешние отступы снизу: 20px.
            /// </remarks>
            -->
            <Border Background="White" Padding="20" Margin="0,0,0,20">

                <StackPanel>
                    <!--
                    /// <summary>
                    /// Заголовок блока информации
                    /// </summary>
                    /// <remarks>
                    /// Цвет текста: #4A3424 (тёмно-коричневый) - основной цвет текста в приложении.
                    /// Размер шрифта: 16, жирное начертание.
                    /// </remarks>
                    -->
                    <TextBlock Text="ИНФОРМАЦИЯ О ПОЛЬЗОВАТЕЛЕ" FontSize="16" FontWeight="Bold" 
                               Foreground="#4A3424" Margin="0,0,0,15"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!--
                        /// <summary>
                        /// Поля с данными пользователя
                        /// </summary>
                        /// <remarks>
                        /// Названия полей: цвет #4A3424 (тёмно-коричневый), жирное начертание.
                        /// Значения полей: цвет по умолчанию (чёрный/тёмно-серый).
                        /// </remarks>
                        -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Имя:" FontWeight="Bold" Foreground="#4A3424"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="UserNameText"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Логин:" FontWeight="Bold" Foreground="#4A3424"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LoginText"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Email:" FontWeight="Bold" Foreground="#4A3424"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="EmailText"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Роль:" FontWeight="Bold" Foreground="#4A3424"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="RoleText"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!--
            /// <summary>
            /// Предупреждение о заморозке аккаунта
            /// </summary>
            /// <remarks>
            /// Отображается только если текущий пользователь заморожен (IsFrozen == true).
            /// Фон: #E74C3C (красный) - цвет тревоги/предупреждения.
            /// Содержит:
            /// - Иконку ⚠️ и текст "АККАУНТ ЗАМОРОЖЕН"
            /// - Причину заморозки (FreezeReason)
            /// - Кнопку "Оспорить заморозку" для подачи заявки на разморозку
            /// 
            /// Цвет кнопки: белый фон, красный текст (#E74C3C).
            /// </remarks>
            -->
            <Border x:Name="FrozenWarning" Background="#E74C3C"  Padding="20" 
                    Margin="0,0,0,20" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="⚠️ ВНИМАНИЕ! АККАУНТ ЗАМОРОЖЕН" FontSize="16" FontWeight="Bold" 
                               Foreground="White" Margin="0,0,0,10"/>
                    <TextBlock x:Name="FreezeReasonText" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button x:Name="AppealBtn" Content="Оспорить заморозку" 
                            Background="White" Foreground="#E74C3C" 
                            Cursor="Hand" Width="150" HorizontalAlignment="Left"
                            Click="AppealBtn_Click"/>
                </StackPanel>
            </Border>

            <!--
            /// <summary>
            /// Панель подачи заявки на роль автора
            /// </summary>
            /// <remarks>
            /// Отображается только для читателей (RoleId == 1), у которых нет активной заявки.
            /// Фон: белый
            /// Содержит:
            /// - Заголовок "Стать автором"
            /// - Описание преимуществ
            /// - Кнопку "Подать заявку" (светло-зелёный фон #C2CDB2)
            /// 
            /// После подачи заявки панель скрывается, отображается RequestStatusPanel.
            /// </remarks>
            -->
            <Border x:Name="AuthorRequestPanel" Background="White" Padding="20" 
                    Margin="0,0,0,20" Visibility="Collapsed">

                <StackPanel>
                    <TextBlock Text="Стать автором" FontSize="16" FontWeight="Bold" 
                               Foreground="#4A3424" Margin="0,0,0,10"/>
                    <TextBlock Text="Хотите публиковать свои книги? Подайте заявку на роль автора." 
                               Foreground="#4A3424" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button x:Name="RequestAuthorBtn" Content="Подать заявку" 
                            Background="#C2CDB2" Foreground="#4A3424" 
                            Cursor="Hand" Width="120" HorizontalAlignment="Left"
                            Click="RequestAuthorBtn_Click"/>
                </StackPanel>
            </Border>

            <!--
            /// <summary>
            /// Панель статуса заявки на роль автора
            /// </summary>
            /// <remarks>
            /// Отображается после подачи заявки. Цвет фона зависит от статуса:
            /// - "В ожидании" - оранжевый (#F39C12)
            /// - "Одобрена" - зелёный (#27AE60)
            /// - "Отклонена" - красный (#E74C3C)
            /// 
            /// Текст статуса белого цвета, жирное начертание.
            /// </remarks>
            -->
            <Border x:Name="RequestStatusPanel" Background="#F39C12" Padding="20" 
                    Margin="0,0,0,20" Visibility="Collapsed">
                <TextBlock x:Name="RequestStatusText" Foreground="White" FontWeight="Bold"/>
            </Border>

            <!--
            /// <summary>
            /// Блок с отзывами пользователя
            /// </summary>
            /// <remarks>
            /// Отображает все отзывы, оставленные текущим пользователем.
            /// Фон: белый
            /// 
            /// Каждый отзыв содержит:
            /// - Название книги (жирный шрифт)
            /// - Рейтинг (звёзды ⭐)
            /// - Текст отзыва
            /// - Дату написания (формат: dd.MM.yyyy)
            /// 
            /// Если отзывов нет - отображается сообщение "У вас пока нет отзывов".
            /// </remarks>
            -->
            <Border Background="White" Padding="20">

                <StackPanel>
                    <TextBlock Text="Мои отзывы" FontSize="18" FontWeight="Bold" 
                               Foreground="#4A3424" Margin="0,0,0,15"/>

                    <ItemsControl x:Name="ReviewsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8F9FA"  Padding="15" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding BookName}" FontWeight="Bold" FontSize="14" Foreground="#4A3424"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Rating, StringFormat='⭐ {0}/10'}" 
                                                       Foreground="#E74C3C"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#4A3424"/>
                                        <TextBlock Text="{Binding DateReview, StringFormat='dd.MM.yyyy'}" 
                                                   FontSize="11" Foreground="#4A3424" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="NoReviewsText" Text="У вас пока нет отзывов" 
                               Foreground="#4A3424" HorizontalAlignment="Center" Margin="0,20"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>