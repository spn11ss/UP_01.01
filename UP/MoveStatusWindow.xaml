<Window x:Class="UP.MoveStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP"
        mc:Ignorable="d"
        Title="Переместить книгу" Height="300" Width="300"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Grid Margin="20">
        <StackPanel>
            <!--
            /// <summary>
            /// Заголовок окна перемещения книги
            /// </summary>
            /// <remarks>
            /// Отображает текст-подсказку для пользователя.
            /// Цвет текста: #4A3424 (тёмно-коричневый).
            /// Размер шрифта: 14px, отступ снизу 15px для отделения от кнопок.
            /// </remarks>
            -->
            <TextBlock Text="Выберите новый статус:" Foreground="#4A3424" FontSize="14" Margin="0,0,0,15"/>

            <!--
            /// <summary>
            /// Кнопка выбора статуса "В планах"
            /// </summary>
            /// <remarks>
            /// При перемещении книги позволяет изменить статус на "В планах".
            /// Параметры:
            /// - Tag: "1" - ID статуса в таблице BookStatuses
            /// - Background: #3498DB (синий)
            /// - Foreground: White - цвет текста
            /// - Height: 40px, отступ снизу 5px
            /// При нажатии вызывает StatusBtn_Click с передачей Tag
            /// </remarks>
            -->
            <Button Name="PlanBtn" Content="В планах" Height="40" Margin="0,5" 
                    Click="StatusBtn_Click" Tag="1" Background="#3498DB" Foreground="White"/>

            <!--
            /// <summary>
            /// Кнопка выбора статуса "Читаю"
            /// </summary>
            /// <remarks>
            /// При перемещении книги позволяет изменить статус на "Читаю".
            /// Параметры:
            /// - Tag: "2" - ID статуса в таблице BookStatuses
            /// - Background: #F39C12 (оранжевый) 
            /// - Foreground: White - цвет текста
            /// - Height: 40px, отступ снизу 5px
            /// При нажатии вызывает StatusBtn_Click с передачей Tag
            /// </remarks>
            -->
            <Button Name="ReadingBtn" Content="Читаю" Height="40" Margin="0,5"
                    Click="StatusBtn_Click" Tag="2" Background="#F39C12" Foreground="White"/>

            <!--
            /// <summary>
            /// Кнопка выбора статуса "Прочитано"
            /// </summary>
            /// <remarks>
            /// При перемещении книги позволяет изменить статус на "Прочитано".
            /// Параметры:
            /// - Tag: "3" - ID статуса в таблице BookStatuses
            /// - Background: #27AE60 (зелёный)
            /// - Foreground: White - цвет текста
            /// - Height: 40px, отступ снизу 5px
            /// При нажатии вызывает StatusBtn_Click с передачей Tag
            /// </remarks>
            -->
            <Button Name="ReadBtn" Content="Прочитано" Height="40" Margin="0,5"
                    Click="StatusBtn_Click" Tag="3" Background="#27AE60" Foreground="White"/>

            <!--
            /// <summary>
            /// Кнопка выбора статуса "Заброшено"
            /// </summary>
            /// <remarks>
            /// При перемещении книги позволяет изменить статус на "Заброшено".
            /// Параметры:
            /// - Tag: "4" - ID статуса в таблице BookStatuses
            /// - Background: #E74C3C (красный) 
            /// - Foreground: White - цвет текста
            /// - Height: 40px, отступ снизу 5px
            /// При нажатии вызывает StatusBtn_Click с передачей Tag
            /// </remarks>
            -->
            <Button Name="AbandonedBtn" Content="Заброшено" Height="40" Margin="0,5"
                    Click="StatusBtn_Click" Tag="4" Background="#E74C3C" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>